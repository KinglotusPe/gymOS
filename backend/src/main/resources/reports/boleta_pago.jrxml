<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="boleta_pago" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="EMPRESA_NOMBRE" class="java.lang.String"/>
    <parameter name="EMPRESA_DIRECCION" class="java.lang.String"/>
    <parameter name="EMPRESA_RUC" class="java.lang.String"/>
    <parameter name="CLIENTE_NOMBRE" class="java.lang.String"/>
    <parameter name="CLIENTE_DNI" class="java.lang.String"/>
    <parameter name="PAGO_FECHA" class="java.lang.String"/>
    <parameter name="PAGO_METODO" class="java.lang.String"/>
    <parameter name="PAGO_NUMERO" class="java.lang.String"/>
    <parameter name="CONCEPTO" class="java.lang.String"/>
    <parameter name="MONTO" class="java.math.BigDecimal"/>

    <title>
        <band height="150">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="70" backcolor="#111827"/>
            </rectangle>
            <staticText>
                <reportElement x="20" y="10" width="300" height="30" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[BRUTAL FITNESS GYM]]></text>
            </staticText>
            <staticText>
                <reportElement x="20" y="42" width="300" height="18" forecolor="#EF4444"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SISTEMA DE GESTIÓN Y ENTRENAMIENTO]]></text>
            </staticText>
            <rectangle>
                <reportElement x="350" y="10" width="190" height="50" backcolor="#FFFFFF"/>
            </rectangle>
            <staticText>
                <reportElement x="355" y="15" width="180" height="15" forecolor="#111827"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[BOLETA DE VENTA ELECTRÓNICA]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="32" width="180" height="20" forecolor="#DC2626"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PAGO_NUMERO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="80" width="555" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Dirección: " + $P{EMPRESA_DIRECCION} + " | RUC: " + $P{EMPRESA_RUC}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="100" width="555" height="1" forecolor="#D1D5DB"/>
            </line>
            <staticText>
                <reportElement x="0" y="105" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Cliente / Socio:]]></text>
            </staticText>
            <textField>
                <reportElement x="85" y="105" width="250" height="16"/>
                <textFieldExpression><![CDATA[$P{CLIENTE_NOMBRE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="350" y="105" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[DNI / Doc:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="105" width="115" height="16"/>
                <textFieldExpression><![CDATA[$P{CLIENTE_DNI}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="125" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Fecha Emisión:]]></text>
            </staticText>
            <textField>
                <reportElement x="85" y="125" width="150" height="16"/>
                <textFieldExpression><![CDATA[$P{PAGO_FECHA}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="350" y="125" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Forma de Pago:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="125" width="115" height="16"/>
                <textFieldExpression><![CDATA[$P{PAGO_METODO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#F3F4F6"/>
            </rectangle>
            <staticText>
                <reportElement x="10" y="5" width="50" height="15"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[ÍTEM]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="5" width="350" height="15"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[DESCRIPCIÓN DEL SERVICIO / PRODUCTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="5" width="115" height="15"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[IMPORTE (S/)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="30">
            <staticText>
                <reportElement x="10" y="5" width="50" height="20"/>
                <text><![CDATA[01]]></text>
            </staticText>
            <textField>
                <reportElement x="70" y="5" width="350" height="20"/>
                <textFieldExpression><![CDATA[$P{CONCEPTO}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="430" y="5" width="115" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{MONTO}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="28" width="555" height="1" forecolor="#E5E7EB"/>
            </line>
        </band>
    </detail>

    <summary>
        <band height="120">
            <rectangle>
                <reportElement x="350" y="15" width="195" height="35" backcolor="#F9FAFB"/>
            </rectangle>
            <staticText>
                <reportElement x="360" y="23" width="70" height="20"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[TOTAL: ]]></text>
            </staticText>
            <textField pattern="S/ #,##0.00">
                <reportElement x="430" y="23" width="105" height="20" forecolor="#DC2626"/>
                <textElement textAlignment="Right"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{MONTO}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="10" y="70" width="535" height="30" forecolor="#6B7280"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Gracias por entrenar en Brutal Fitness. Las cuotas canceladas no están sujetas a devolución.
Conserve este comprobante ante cualquier consulta en recepción.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
